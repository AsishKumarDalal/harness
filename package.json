{
  "name": "the-harness",
  "version": "0.1.0",
  "description": "A small, complete agentic coding CLI — npm install, Python inside.",
  "type": "commonjs",
  "bin": {
    "harness": "bin/harness.js",
    "harness-tui": "bin/harness-tui.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "cli.py",
    "config.py",
    "context.py",
    "llm.py",
    "main.py",
    "messages.py",
    "safety.py",
    "sessions.py",
    "skills.py",
    "subagents.py",
    "tools.py",
