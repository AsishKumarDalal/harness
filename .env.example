# Agentic harness config. The npm launcher creates this file at
# ~/.harness/.env on the first run; ./install.sh creates <repo>/.env.
# Edit whichever copy your setup made (the repo one wins if both exist).

# Any OpenAI-compatible endpoint. The server usually ignores the key,
# but the SDK insists on one being present.
OPENAI_API_KEY=ollama

# Leave empty for the official OpenAI endpoint, e.g.
#   BASE_URL=https://api.openai.com/v1
BASE_URL=https://your-tunnel-or-host/v1

# The model your server serves.
MODEL=gpt-4o-mini

# --- optional knobs (defaults in config.py) ---
# CONTEXT_LIMIT=50000
# CONTEXT_RESERVE=12000
# MAX_SUBAGENTS=3
# SUBAGENT_MAX_TURNS=12
# MAX_SPAWN_DEPTH=1
# HARNESS_HOME=~/.harness
