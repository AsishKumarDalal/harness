/* =============================================================================
   harness TUI — theme
   -----------------------------------------------------------------------------
   EVERY colour in the app lives here as a variable. Swap these values to
   re-theme the whole UI; no other file mentions a colour.

   The `$h-` prefix is deliberate: a CSS variable that shares a name with a
   Textual theme variable ($panel, $surface, ...) would be defined twice and
   break Textual's stylesheet parsing. Textual's own variables are derived
   from this palette in tui/theme.py, so built-in widgets (Markdown,
   OptionList, scrollbars) match.
   ============================================================================= */

$h-bg: #0b0f14;          /* screen background            */
$h-surface: #111823;     /* raised panels, input, prompt */
$h-panel: #0d131b;       /* status line, hints           */
$h-border: #1d2733;      /* hairline borders             */
$h-text: #c7d2e0;        /* primary text                 */
$h-muted: #64748b;       /* dim text, tool output        */
$h-accent: #7aa2f7;      /* the one accent colour        */
$h-success: #7ee787;     /* done                         */
$h-error: #ff7b72;       /* failed                       */
$h-warning: #e3b341;     /* approval prompts             */

/* --- screen ---------------------------------------------------------------- */
Screen {
    background: $h-bg;
    color: $h-text;
}

/* --- chat history ---------------------------------------------------------- */
#chat {
    height: 1fr;
    padding: 1 2 0 2;
    background: $h-bg;
    scrollbar-size-vertical: 1;
    scrollbar-color: $h-border;
    scrollbar-background: $h-bg;
}

.welcome {
    color: $h-muted;
    margin-bottom: 1;
}

.user-message {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $h-surface;
    border-left: solid $h-accent;
    color: $h-text;
}

.assistant-message {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;              /* aligns with the text of a user message */
    color: $h-text;
}

.thinking {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $h-muted;
    text-style: italic;
}

.note {
    width: auto;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $h-muted;
}

.help {
    background: $h-panel;
    color: $h-text;
}

/* --- markdown -------------------------------------------------------------- */
Markdown {
    color: $h-text;
    margin: 0;
}

MarkdownBlock {
    color: $h-text;
}

/* --- tool call blocks ------------------------------------------------------ */
ToolBlock {
    height: auto;
    margin: 0 0 1 0;
}

ToolBlock > .tool-header {
    height: 1;
    padding: 0 1;
    background: $h-panel;
    color: $h-muted;
}

ToolBlock > .tool-body {
    height: auto;
    max-height: 24;
    overflow-y: auto;
    padding: 0 1;
    background: $h-bg;
}

ToolBlock > .tool-body > .tool-output {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    color: $h-muted;
}

DiffView {
    height: auto;
    max-height: 20;
    overflow-y: auto;
    padding: 0 1;
    background: $h-bg;
    color: $h-text;
}

/* --- approval prompt ------------------------------------------------------- */
ApprovalPrompt {
    height: auto;
    display: none;
    padding: 0 1;
    background: $h-surface;
    border: solid $h-warning;
}

ApprovalPrompt > .approval-title {
    height: 1;
    color: $h-warning;
    text-style: bold;
}

ApprovalPrompt > .approval-body {
    height: auto;
    max-height: 6;
    overflow-y: auto;
    color: $h-text;
}

ApprovalPrompt > .approval-hint {
    height: 1;
    color: $h-muted;
}

/* --- palette --------------------------------------------------------------- */
PaletteScreen {
    align: center middle;
    background: $h-bg 60%;
}

PaletteScreen > #palette {
    width: 70%;
    max-width: 90;
    height: auto;
    max-height: 70%;
    padding: 1;
    background: $h-surface;
    border: solid $h-accent;
}

PaletteScreen > #palette > #palette-title {
    height: 1;
    color: $h-accent;
    text-style: bold;
}

PaletteScreen > #palette > #palette-filter {
    height: 3;
    border: solid $h-border;
    background: $h-bg;
}

PaletteScreen > #palette > #palette-options {
    height: auto;
    max-height: 18;
    background: $h-surface;
}

OptionList {
    background: $h-surface;
    color: $h-text;
}

OptionList > .option-list--option-highlighted {
    background: $h-accent 25%;
    color: $h-text;
    text-style: bold;
}

/* --- prompt dock ----------------------------------------------------------- */
#prompt-dock {
    height: auto;
    padding: 0 2;
    background: $h-bg;
}

PromptInput {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0 1;
    background: $h-surface;
    color: $h-text;
    border: solid $h-border;
}

PromptInput:focus {
    border: solid $h-accent;
}

/* --- status line + hints --------------------------------------------------- */
StatusBar {
    height: 1;
    padding: 0 2;
    background: $h-panel;
    color: $h-muted;
}

HintBar {
    height: 1;
    padding: 0 2;
    background: $h-panel;
    color: $h-muted;
}
